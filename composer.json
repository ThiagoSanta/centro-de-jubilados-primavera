{
    "name": "cjp/centro-jubilados-primavera",
    "description": "Sistema de gestión de socios y cobranzas - Centro de Jubilados Primavera",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "setasign/fpdf": "^1.8",
        "endroid/qr-code": "^6.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "CJP\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CJP\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
