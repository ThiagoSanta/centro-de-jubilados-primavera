# ============================================================
# Centro de Jubilados Primavera — Variables de Entorno de Ejemplo
# Copiar este archivo a .env y ajustar los valores según corresponda:
#   copy .env.example .env
# ============================================================

# Conexión a la base de datos MariaDB / MySQL
DB_HOST=localhost
DB_NAME=centro_jubilados_primavera
DB_USER=root
DB_PASS=

# URL base absoluta del sistema hasta la carpeta /public.
# Para pruebas locales en la PC: http://localhost/centro-de-jubilados-primavera/public
# Para pruebas desde celular en red Wi-Fi: http://192.168.1.X/centro-de-jubilados-primavera/public (averiguar IP con ipconfig)
APP_URL=http://localhost/centro-de-jubilados-primavera/public

# Ruta absoluta al ejecutable PHP CLI en XAMPP (requerido para worker de importación CSV en segundo plano)
# Ejemplos habituales: C:\xampp\php\php.exe o C:\xampp\php\windowsXamppPhp\php.exe
PHP_CLI_PATH=C:\xampp\php\php.exe

# Tiempo de expiración de sesión por inactividad (en segundos)
# Administrador: 28800 segundos (8 horas)
# Cobrador: 1800 segundos (30 minutos)
SESSION_LIFETIME_ADMINISTRADOR=28800
SESSION_LIFETIME_COBRADOR=1800
